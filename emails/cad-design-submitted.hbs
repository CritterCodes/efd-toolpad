<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Design Submission Received</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e4e4e7;">
          <tr>
            <td style="background:#0a0a0a;padding:20px 28px;">
              <span style="color:#D4AF37;font-size:18px;font-weight:600;letter-spacing:0.5px;">Engel Fine Design</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              {{#if recipientName}}<p style="margin:0 0 16px;font-size:15px;">Hi {{recipientName}},</p>{{/if}}
              <h1 style="margin:0 0 12px;font-size:20px;font-weight:600;color:#18181b;">Design submission received</h1>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#3f3f46;">Thank you! Your design for <strong>&ldquo;{{productTitle}}&rdquo;</strong> has been received and is now under review.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fafafa;border:1px solid #e4e4e7;border-radius:8px;margin:0 0 24px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 10px;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Submission details</p>
                    <p style="margin:0 0 4px;font-size:15px;line-height:1.6;color:#3f3f46;"><strong>Design title:</strong> {{designTitle}}</p>
                    <p style="margin:0 0 4px;font-size:15px;line-height:1.6;color:#3f3f46;"><strong>Submitted:</strong> {{submittedDate}}</p>
                    <p style="margin:0;font-size:15px;line-height:1.6;color:#3f3f46;"><strong>Files:</strong> {{fileCount}} file(s)</p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 8px;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">What happens next</p>
              <ul style="margin:0 0 24px;padding-left:20px;font-size:15px;line-height:1.7;color:#3f3f46;">
                <li>Our team will review your design within 3-5 business days</li>
                <li>The customer will also provide feedback</li>
                <li>You'll receive notifications about their response</li>
                <li>Iterate and improve based on feedback if needed</li>
              </ul>

              <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#3f3f46;">We appreciate your careful work and attention to detail!</p>

              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-radius:8px;background:#0a0a0a;">
                    <a href="{{actionUrl}}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">{{#if actionLabel}}{{actionLabel}}{{else}}View Submission{{/if}}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px;border-top:1px solid #e4e4e7;background:#fafafa;">
              <p style="margin:0;font-size:12px;color:#a1a1aa;">Engel Fine Design &middot; <a href="{{shopUrl}}" style="color:#a1a1aa;">Shop</a> &middot; Questions? <a href="mailto:{{supportEmail}}" style="color:#a1a1aa;">{{supportEmail}}</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update on your artisan application</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e4e4e7;">
          <tr>
            <td style="background:#0a0a0a;padding:20px 28px;">
              <span style="color:#D4AF37;font-size:18px;font-weight:600;letter-spacing:0.5px;">Engel Fine Design</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 16px;font-size:15px;">Hi {{#if artisanName}}{{artisanName}}{{else}}{{recipientName}}{{/if}},</p>
              <h1 style="margin:0 0 12px;font-size:20px;font-weight:600;color:#18181b;">Update on your artisan application</h1>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#3f3f46;">
                Thank you for taking the time to apply to the Engel Fine Design artisan network. After reviewing your
                application, we aren't able to move forward with a partnership right now.
              </p>

              {{#if reason}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fafafa;border:1px solid #e4e4e7;border-radius:8px;margin:0 0 24px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Feedback</p>
                    <p style="margin:0;font-size:15px;line-height:1.6;color:#3f3f46;">{{reason}}</p>
                  </td>
                </tr>
              </table>
              {{/if}}

              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#3f3f46;">
                This isn't a permanent no — we'd genuinely welcome another application as your work and portfolio grow.
                If you'd like to talk it through, just reply to this email or write to
                <a href="mailto:{{supportEmail}}" style="color:#0a0a0a;">{{supportEmail}}</a>.
              </p>

              <!-- No admin CTA here: a rejected applicant has no admin dashboard. The previous actionUrl pointed
                   at /artisan-application, a route that does not exist in this app — a hard 404 in the one email
                   where a broken link lands worst. -->
              <p style="margin:0;font-size:15px;line-height:1.6;color:#3f3f46;">
                Your shop account is unchanged, and you're welcome to keep shopping with us at
                <a href="{{shopUrl}}" style="color:#0a0a0a;">{{shopUrl}}</a>.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px;border-top:1px solid #e4e4e7;background:#fafafa;">
              <p style="margin:0;font-size:12px;color:#a1a1aa;">Engel Fine Design &middot; <a href="{{shopUrl}}" style="color:#a1a1aa;">Shop</a> &middot; Questions? <a href="mailto:{{supportEmail}}" style="color:#a1a1aa;">{{supportEmail}}</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

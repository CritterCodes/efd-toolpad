<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Casting order {{orderRef}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e4e4e7;">
          <tr>
            <td style="background:#0a0a0a;padding:20px 28px;">
              <span style="color:#D4AF37;font-size:18px;font-weight:600;letter-spacing:0.5px;">Engel Fine Design</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 16px;font-size:15px;">{{#if accountManager}}Hi {{accountManager}},{{else}}Hello,{{/if}}</p>
              <h1 style="margin:0 0 12px;font-size:20px;font-weight:600;color:#18181b;">Casting order {{orderRef}}</h1>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#3f3f46;">
                Please cast the following for us. <strong>This order ships DIRECT to our artisan</strong> at the
                address below &mdash; please do <strong>not</strong> ship it to the Engel Fine Design shop.
              </p>

              <!-- SHIP TO — deliberately the most prominent block in this email. -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fffbeb;border:2px solid #f59e0b;border-radius:8px;margin:0 0 24px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 8px;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#92400e;">&#9873; Drop ship to (not to EFD)</p>
                    <p style="margin:0;font-size:16px;font-weight:700;line-height:1.5;color:#18181b;">
                      {{shipTo.name}}<br />
                      {{#if shipToBusinessLine}}{{shipToBusinessLine}}<br />{{/if}}
                      {{shipTo.address}}<br />
                      {{shipTo.city}}, {{shipTo.state}} {{shipTo.zip}}<br />
                      {{shipTo.country}}
                    </p>
                  </td>
                </tr>
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 24px;">
                <thead>
                  <tr style="background:#fafafa;">
                    <th align="left" style="padding:10px 8px;border-bottom:2px solid #e4e4e7;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Metal</th>
                    <th align="left" style="padding:10px 8px;border-bottom:2px solid #e4e4e7;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Item</th>
                    <th align="center" style="padding:10px 8px;border-bottom:2px solid #e4e4e7;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Qty</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each lines}}
                  <tr>
                    <td style="padding:10px 8px;border-bottom:1px solid #e4e4e7;font-size:15px;color:#3f3f46;"><strong>{{this.metalLabel}}</strong></td>
                    <td style="padding:10px 8px;border-bottom:1px solid #e4e4e7;font-size:15px;color:#3f3f46;">
                      {{../designName}}{{#if this.sku}} &middot; {{this.sku}}{{/if}}
                      {{#if this.ringSize}}<br /><span style="color:#71717a;font-size:13px;">Ring size {{this.ringSize}}</span>{{/if}}
                    </td>
                    <td align="center" style="padding:10px 8px;border-bottom:1px solid #e4e4e7;font-size:16px;color:#18181b;"><strong>{{this.qty}}</strong></td>
                  </tr>
                  {{/each}}
                  <tr>
                    <td colspan="2" align="right" style="padding:10px 8px;font-size:15px;font-weight:600;color:#18181b;">Total pieces</td>
                    <td align="center" style="padding:10px 8px;font-size:16px;font-weight:700;color:#18181b;">{{totalQty}}</td>
                  </tr>
                </tbody>
              </table>

              <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#3f3f46;"><strong>Model:</strong> {{modelSource}}</p>
              {{#if stlUrl}}
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;"><a href="{{stlUrl}}" style="color:#0a0a0a;font-weight:600;">Download the STL</a></p>
              {{/if}}

              {{#if notes}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fafafa;border:1px solid #e4e4e7;border-radius:8px;margin:0 0 20px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;color:#71717a;">Notes</p>
                    <p style="margin:0;font-size:15px;line-height:1.6;color:#3f3f46;">{{notes}}</p>
                  </td>
                </tr>
              </table>
              {{/if}}

              <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#3f3f46;">Please confirm receipt and the expected ship date. Thank you!</p>
              <p style="margin:0;font-size:14px;line-height:1.6;color:#71717a;">
                Order reference <strong>{{orderRef}}</strong> &middot; design {{designID}}<br />
                Placed {{placedAt}}{{#if placedBy}} by {{placedBy}}{{/if}} via the EFD production system.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px;border-top:1px solid #e4e4e7;background:#fafafa;">
              <p style="margin:0;font-size:12px;color:#a1a1aa;">Engel Fine Design &middot; Reply to this email to reach us about this order.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

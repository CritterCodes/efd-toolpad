<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Casting order {{orderRef}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <div style="max-width:640px;margin:0 auto;padding:24px;">

    <div style="background:#111827;color:#ffffff;padding:16px 20px;border-radius:8px 8px 0 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.8;">Engel Fine Design</div>
      <div style="font-size:20px;font-weight:bold;margin-top:4px;">Casting order {{orderRef}}</div>
    </div>

    <div style="background:#ffffff;padding:20px;border:1px solid #e5e7eb;border-top:none;">
      <p style="margin:0 0 16px;">
        {{#if accountManager}}Hi {{accountManager}},{{else}}Hello,{{/if}}
      </p>
      <p style="margin:0 0 20px;">
        Please cast the following for us. <strong>This order ships DIRECT to our artisan</strong> at the
        address below &mdash; please do <strong>not</strong> ship it to the Engel Fine Design shop.
      </p>

      <!-- SHIP TO — deliberately the most prominent block in this email. -->
      <div style="border:3px solid #b45309;background:#fffbeb;border-radius:8px;padding:16px;margin:0 0 24px;">
        <div style="font-size:12px;font-weight:bold;letter-spacing:.1em;text-transform:uppercase;color:#b45309;margin-bottom:8px;">
          ⚑ Drop ship to (not to EFD)
        </div>
        <div style="font-size:16px;font-weight:bold;line-height:1.5;">
          {{shipTo.name}}<br>
          {{#if shipToBusinessLine}}{{shipToBusinessLine}}<br>{{/if}}
          {{shipTo.address}}<br>
          {{shipTo.city}}, {{shipTo.state}} {{shipTo.zip}}<br>
          {{shipTo.country}}
        </div>
      </div>

      <table style="width:100%;border-collapse:collapse;margin:0 0 20px;">
        <thead>
          <tr style="background:#f9fafb;">
            <th align="left" style="padding:8px;border-bottom:2px solid #e5e7eb;font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Metal</th>
            <th align="left" style="padding:8px;border-bottom:2px solid #e5e7eb;font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Item</th>
            <th align="center" style="padding:8px;border-bottom:2px solid #e5e7eb;font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Qty</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
          <tr>
            <td style="padding:10px 8px;border-bottom:1px solid #f3f4f6;"><strong>{{this.metalLabel}}</strong></td>
            <td style="padding:10px 8px;border-bottom:1px solid #f3f4f6;">
              {{../designName}}{{#if this.sku}} &middot; {{this.sku}}{{/if}}
              {{#if this.ringSize}}<br><span style="color:#6b7280;font-size:13px;">Ring size {{this.ringSize}}</span>{{/if}}
            </td>
            <td align="center" style="padding:10px 8px;border-bottom:1px solid #f3f4f6;font-size:16px;"><strong>{{this.qty}}</strong></td>
          </tr>
          {{/each}}
          <tr>
            <td colspan="2" align="right" style="padding:10px 8px;font-weight:bold;">Total pieces</td>
            <td align="center" style="padding:10px 8px;font-size:16px;font-weight:bold;">{{totalQty}}</td>
          </tr>
        </tbody>
      </table>

      <p style="margin:0 0 8px;"><strong>Model:</strong> {{modelSource}}</p>
      {{#if stlUrl}}
      <p style="margin:0 0 16px;"><a href="{{stlUrl}}" style="color:#b45309;">Download the STL</a></p>
      {{/if}}

      {{#if notes}}
      <div style="background:#f9fafb;border-left:4px solid #9ca3af;padding:12px;margin:0 0 16px;">
        <strong>Notes:</strong> {{notes}}
      </div>
      {{/if}}

      <p style="margin:16px 0 0;">
        Please confirm receipt and the expected ship date. Thank you!
      </p>
      <p style="margin:16px 0 0;color:#6b7280;font-size:13px;">
        Order reference <strong>{{orderRef}}</strong> &middot; design {{designID}}<br>
        Placed {{placedAt}}{{#if placedBy}} by {{placedBy}}{{/if}} via the EFD production system.
      </p>
    </div>

    <div style="padding:12px 20px;color:#9ca3af;font-size:12px;text-align:center;">
      Engel Fine Design &middot; reply to this email to reach us about this order.
    </div>
  </div>
</body>
</html>
